---
// The drawings the map shows, once each: a symbol per lesson and per pillar, and the badge's shared plate. A tile or an
// emblem then refers to one with <use> (Glyph.astro, Emblem.astro, `sprite`). Out of sight, and out of the accessibility tree.
import { readFileSync } from 'node:fs';
import { lessonGlyph, pillarGlyph, symbolId } from '../lib/glyphs.ts';

const { lessons, pillars } = Astro.props as { lessons: string[]; pillars: string[] };
const drawings = [...pillars.map((p) => [`p-${p}`, pillarGlyph(p)] as const), ...lessons.map((l) => [symbolId(l), lessonGlyph(l)] as const)];
// The map's own icons, one copy each, not one per card.
const icons = ['clock', 'circle-dashed', 'check-circle', 'seal-check'].map((name) => [name, /<svg[^>]*>(.*)<\/svg>/s.exec(readFileSync(`node_modules/@phosphor-icons/core/assets/regular/${name}.svg`, 'utf8'))![1]] as const);
---

<svg class="sprite" width="0" height="0" aria-hidden="true" focusable="false">
  {drawings.map(([id, g]) => <symbol id={id} viewBox={`0 0 ${g.view} ${g.view}`} set:html={g.inner} />)}
  {icons.map(([name, paths]) => <symbol id={`i-${name}`} viewBox="0 0 256 256" set:html={paths} />)}
  <symbol id="emblem-art" viewBox="0 0 96 96" class="emblem-art">
    <path class="plate" d="M48 7 83.5 27.5v41L48 89 12.5 68.5v-41z" />
    <path class="rim-in" d="M48 14.5 77 31.25v33.5L48 81.5 19 64.75v-33.5z" />
    <path class="bridge" d="M31 71Q48 63 65 71" />
    <circle class="spark" cx="48" cy="7" r="4.5" />
  </symbol>
</svg>
